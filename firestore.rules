rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.role == 'admin';
    }

    function isEngineerOrAdmin() {
      return request.auth != null &&
        request.auth.token.role in ['engineer', 'admin'];
    }

    // Returns true if the calling user is in the incident's assignees list
    // Intentionally does NOT check the JWT role claim — custom claims require a
    // token refresh and may not be present on an existing session.
    function isAssignedEngineer() {
      return request.auth != null &&
        'assignees' in resource.data &&
        request.auth.uid in resource.data.assignees.map(a, a.uid);
    }

    match /topology/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Compact denormalized world state. Clients subscribe to this single doc
    // via onSnapshot instead of polling collection endpoints — this is what
    // keeps daily Firestore reads bounded regardless of user count.
    match /meta/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /alarms/{document=**} {
      allow read: if request.auth != null;
      allow write: if isEngineerOrAdmin();
    }

    match /incidents/{incidentNumber} {
      allow read: if request.auth != null;
      allow create: if isEngineerOrAdmin();

      // Admins can update anything.
      // Assigned engineers can only touch lifecycle fields.
      allow update: if isAdmin()
        || (isEngineerOrAdmin() &&
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'siteIds',
                'antennaIds',
                'alarmIds',
                'technologies',
                'urgency',
                'impact',
                'priority'
              ]))
        || (isAssignedEngineer() &&
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['status', 'resolvedDate', 'closedDate']));

      allow delete: if false;
    }

    // Per-incident activity timeline
    // System events (create/ack/resolve/close/assign/merge) are written
    // via the admin SDK and bypass these rules entirely.
    // Engineers and admins can append 'note' entries; the actorUid must
    // match the authenticated user to prevent impersonation.
    match /incidents/{incidentNumber}/activity/{activityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.type == 'note';
      allow update, delete: if false;
    }

    // Per-incident team chat
    // Incident IDs are timestamp-based and not guessable; the senderId check
    // prevents impersonation. Cross-collection get() is avoided intentionally
    // because it causes permission errors on collection queries.
    match /chats/{incidentId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.role == 'user';
      allow update: if
        (request.auth != null &&
         request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']))
        || (isAdmin() && request.resource.data.role in ['user', 'engineer', 'technician']);
      allow delete: if false;
    }
  }
}
